    "mock:tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/logic.test.ts",
    "check-urls": "node scripts/check-urls.mjs",
    "seed": "node scripts/seed-supabase.mjs",
    "fn:serve": "supabase functions serve --env-file supabase/.env.local",
    "fn:tunnel": "ngrok http 54321",
    "testflight": "eas build -p ios --profile production --auto-submit"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.0",
    "@expo-google-fonts/archivo-narrow": "^0.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.48.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.0",
    "expo-image-manipulator": "~14.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-keep-awake": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-location": "~19.0.0",
    "expo-router": "~6.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
