{
  "name": "fullcharge-nhtsa-tools",
  "private": true,
  "type": "module",
  "description": "Scrape every NHTSA ERG / rescue sheet, download the PDFs, publish them as the FULLCHARGE 'All cut sheets' pack. Runs on your PC, not in the app.",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "scrape": "node --experimental-strip-types scrape.mjs",
    "download": "node --experimental-strip-types download.mjs",
    "publish": "node --experimental-strip-types publish.mjs",
    "all": "npm run scrape && npm run download && npm run compress && npm run publish",
    "compress": "node --experimental-strip-types compress.mjs",
    "photos:find": "node --experimental-strip-types photos-find.mjs",
    "photos:build": "node --experimental-strip-types photos-build.mjs",
    "logos:find": "node --experimental-strip-types logos.mjs find",
    "logos:build": "node --experimental-strip-types logos.mjs build",
    "pictures": "npm run logos:find && npm run guide:scan && npm run photos:find",
    "guide:scan": "node --experimental-strip-types guide-scan.mjs",
    "publish:extras": "node --experimental-strip-types publish-extras.mjs",
    "callouts:propose": "node --experimental-strip-types callouts.mjs propose",
    "callouts:review": "node --experimental-strip-types callouts.mjs review",
    "callouts:publish": "node --experimental-strip-types callouts.mjs publish",
    "vin:build": "node --experimental-strip-types vin.mjs build",
    "vin:check": "node --experimental-strip-types vin.mjs check",
    "vin:publish": "node --experimental-strip-types vin.mjs publish"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "sharp": "^0.34.0"
  }
}
