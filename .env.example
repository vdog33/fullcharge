# ---- App (bundled into the client — public values only) ----
# true = no network calls: local catalog, mock camera ID, mock VIN/plate, mock auth, simulated pack downloads
EXPO_PUBLIC_USE_MOCKS=true

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: point edge-function calls at a local `supabase functions serve` exposed by ngrok
# e.g. https://abcd-1234.ngrok-free.app/functions/v1
EXPO_PUBLIC_FUNCTIONS_URL=

# ---- Server only (supabase/.env.local or `supabase secrets set`) — NEVER prefix with EXPO_PUBLIC ----
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# PLATE_API_URL=
# PLATE_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   (seed script only)
